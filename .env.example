# Site root. Use "/" for local preview and for Heart Internet.
# GitHub Pages project site uses /fombl/ (npm run build:pages).
# The Pages workflow also sets this from the repository name, or from
# the Actions variable PAGES_BASE_PATH when you need a different root.
VITE_BASE_PATH=/

# prototype asks search engines not to index the build (GitHub Pages).
# live is what build:host sets for Heart Internet.
VITE_SITE_PHASE=prototype

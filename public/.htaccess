# Apache rules for Heart Internet. GitHub Pages ignores this file.
# Assumes the site is the document root of the domain. Deep links such as
# /events are handed to the app; real files (CSS, JS, PDFs, images) are served as-is.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files as-is (PDFs, images, hashed assets).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Serve directories only when they have an index.html. Bare folders such as
  # /news (from public/news/) must fall through to the SPA — otherwise Apache
  # hits Options -Indexes and returns 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
